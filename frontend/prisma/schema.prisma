// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./prisma/dev.db"
}


// --------------------------------------------------------
// 1. TRADES (Populates: Win Rate, Total P&L, Avg Confidence)
// --------------------------------------------------------
model Trade {
  id              String   @id @default(uuid())
  
  // Token Details
  tokenIn         String   // e.g. "CRO"
  tokenOut        String   // e.g. "USDC"
  amountIn        Float    // Raw amount sent
  amountOut       Float    // Raw amount received
  
  // USD Values (Critical for P&L)
  priceInUsd      Float    // Price of tokenIn at moment of trade
  priceOutUsd     Float    // Price of tokenOut at moment of trade
  valueInUsd      Float    // (amountIn * priceInUsd)
  valueOutUsd     Float    // (amountOut * priceOutUsd)
  
  // Metrics
  realizedPnL     Float    // (valueOutUsd - valueInUsd) - fees
  pnlPercentage   Float    // ((valueOutUsd - valueInUsd) / valueInUsd) * 100
  isWin           Boolean  // True if realizedPnL > 0
  
  // AI Data
  confidence      Float    // 0.0 to 1.0 (Populates "Avg Confidence")
  strategy        String?  // e.g. "arbitrage", "trend_follow"
  reasoning       String?  // The "thought" from the AI
  
  // Blockchain Info
  txHash          String   @unique
  blockNumber     Int?
  status          String   @default("CONFIRMED") // PENDING, CONFIRMED, FAILED
  
  timestamp       DateTime @default(now())
  alphaNodes      AlphaNode[] @relation("TradeAlphaNodes")
  tradeDecisions TradeDecision[]
}

// --------------------------------------------------------
// 2. ALPHA / SIGNALS (Populates: "Alpha Purchased")
// --------------------------------------------------------

model AlphaNode {
    trades          Trade[]     @relation("TradeAlphaNodes")
  id                 String   @id @default(uuid())
  name               String
  category           String
  description        String?
  price              Float    @default(0.0)
  reputation         Int      @default(0)
  status             String   @default("active") // "active", "inactive"
  isPurchased        Boolean  @default(false)
  
  // --- NEW: Technical Connectivity ---
  endpointUrl        String?
  apiKey             String?
  icon               String   @default("activity")
  
  // --- NEW: Professional Data Metadata ---
  qualityScore       Int      @default(0)      // 0-100 metric
  latencyMs          Int      @default(0)      // For HFT strategy matching
  assetCoverage      String?                   // Comma-separated tickers (e.g., "WETH, USDC")
  granularity        String?                   // e.g., "Tick", "1m", "Daily"
  lastUpdated        DateTime @default(now())  // Freshness check
  
  // --- NEW: Strategy Integrity ---
  hasPitFlag         Boolean  @default(false)  // Point-in-Time Flag
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// --------------------------------------------------------
// 3. EQUITY HISTORY (Populates: "Cumulative Returns" Chart)
// --------------------------------------------------------
model PortfolioSnapshot {
  id              String   @id @default(uuid())
  timestamp       DateTime @default(now())
  
  totalValueUsd   Float    // Combined value of all assets
  croBalance      Float
  usdcBalance     Float
  otherBalance    Float    @default(0)
  
  // Optional: Track Alpha count at this snapshot for historical comparison
  alphaCount      Int      @default(0)
}

// --------------------------------------------------------
// 4. SETTINGS (Populates: "Wallet Balance" / Config)
// --------------------------------------------------------
model SystemState {
  key             String   @id // e.g. "last_sync_block", "wallet_address"
  value           String
  updatedAt       DateTime @updatedAt
}

// --------------------------------------------------------
// 5. ALPHA MARKET (The 48 Data Providers)
// --------------------------------------------------------
// AlphaNode model removed

// --------------------------------------------------------
// 6. DATA LOG (History of Data Points Fetched)
// --------------------------------------------------------
model DataLog {
  id          String   @id @default(uuid())
  // nodeId and node relation removed
  data        String   // Raw data fetched (JSON, text, etc.)
  normalized  Float?   // Normalized signal value, if applicable
  fetchedAt   DateTime @default(now())
  tradeDecisions TradeDecision[]
}

// --------------------------------------------------------
// 7. TRADE DECISION (Link Trade to Data Point)
// --------------------------------------------------------
model TradeDecision {
  id          String   @id @default(uuid())
  tradeId     String
  trade       Trade    @relation(fields: [tradeId], references: [id])
  dataLogId   String
  dataLog     DataLog  @relation(fields: [dataLogId], references: [id])
  decidedAt   DateTime @default(now())
}