# Required: wallet address to receive USDC payments
WALLET_ADDRESS=0xYourCronosAddressHere

# Token and payment config (Cronos USDC)
USDC_CONTRACT=0xYourUSDCContractAddress
PAYMENT_SYMBOL=USDC
PAYMENT_DECIMALS=6

# Price to access one insight (base units). Example: 100000 = 0.10 USDC
PAYMENT_AMOUNT=100000

# Network config
PAYMENT_NETWORK=cronos_testnet
CHAIN_ID=338
PAYMENT_TTL_SECONDS=900

# Optional: override server port (defaults to 3050)
# PORT=3050
