# Alpha-Consumer Agent Configuration

# ===================================
# AI Configuration (OpenRouter)
# ===================================
# Get your API key from: https://openrouter.ai/
# Default model uses Gemini via OpenRouter; override if you prefer another
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# Optional: override base URL or add ranking metadata for OpenRouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://your-site-url.example
# OPENROUTER_SITE_NAME=Alpha Consumer Agent

# ===================================
# Blockchain Configuration
# ===================================
# Your wallet private key (DO NOT COMMIT THE REAL KEY!)
# Generate a new wallet: from eth_account import Account; print(Account.create().key)
WALLET_PRIVATE_KEY=0x1234567890123456789012345678901234567890123456789012345678901234

# ===================================
# Crypto.com Developer Platform
# ===================================
# Get your API key from: https://developers.crypto.com/console
# This is required for the AI Agent SDK to interact with blockchain
CRYPTO_COM_API_KEY=your_crypto_com_api_key_here

# ===================================
# Optional: Server Configuration
# ===================================
# Mock server receiving payments
SELLER_WALLET=0x0000000000000000000000000000000000000000
PAYMENT_AMOUNT=1000000

# Server port
PORT=3100

# ===================================
# Notes
# ===================================
# 1. The AI Agent SDK handles blockchain interactions through Crypto.com Developer Platform
# 2. No need to specify CRONOS_RPC_URL or CHAIN_ID - SDK handles this automatically
# 3. Never commit your real private key or API keys to version control
# 4. For testing: Get testnet tokens from Cronos faucets
# 4. SELLER_WALLET should be a different address that receives payments
