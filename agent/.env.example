# Alpha-Consumer Agent Configuration

# ===================================
# AI Configuration (Gemini)
# ===================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===================================
# Blockchain Configuration
# ===================================
# Cronos Testnet Configuration
CHAIN_ID=338
CRONOS_RPC_URL=https://evm-t3.cronos.org

# Your wallet private key (DO NOT COMMIT THE REAL KEY!)
# Generate a new wallet by running: python wallet_manager.py
WALLET_PRIVATE_KEY=0x1234567890123456789012345678901234567890123456789012345678901234

# ===================================
# Contract Addresses (Cronos Testnet)
# ===================================
# USDC Test Token (Update with actual testnet address)
USDC_CONTRACT=0x0000000000000000000000000000000000000000

# ===================================
# Server Configuration
# ===================================
# Mock server receiving payments
SELLER_WALLET=0x0000000000000000000000000000000000000000
PAYMENT_AMOUNT=1000000

# Server port
PORT=3100

# Optional: Production facilitator URL
# FACILITATOR_URL=https://facilitator.example.com/api/v1/submit

# ===================================
# Notes
# ===================================
# 1. Get testnet TCRO from: https://cronos.org/faucet
# 2. For devUSDC, check hackathon resources or deploy your own test token
# 3. Never commit your real private key or API keys to version control
# 4. SELLER_WALLET should be a different address that receives payments
